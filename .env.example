# ============================================
# StreamRecap — Env Variables (copy to .env)
# ============================================

# Twitch API credentials (optional, for exact timestamps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# LLM provider key (used by the AI recap server / creator ingest)
# OPENAI_API_KEY=sk-...
RECAP_MODEL=openai/gpt-4o-mini

# Targeted visual validation for low-confidence recap events. Uses the same
# OpenRouter key as recap generation and only inspects up to 12 flagged events.
VISION_VALIDATION_ENABLED=true
VISION_VALIDATION_MODEL=openai/gpt-4o
VISION_VALIDATION_MAX_EVENTS=12
VISION_VALIDATION_TIMEOUT_MS=60000

# ============================================
# Community Discussion & Reddit Discovery (2 Methods)
# ============================================

# Method 1 (Recommended): Search Engine Discovery for Reddit.
# Bypasses Reddit Developer Platform gatekeeping by querying indexed public threads.
# Generous free tier (2,000 free queries/mo) — get a free key in 60 seconds at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Alternatively, Google Programmable Search (100 free queries/day from Google Cloud Console):
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Method 2: Official Reddit Data API (requires approved Reddit Developer account).
REDDIT_RESEARCH_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:StreamRecap:v1.0.0 (by /u/StreamRecapDev)

# Server port (default 3002)
PORT=3002

# Owner-only actions (add stream, sync, delete). Guests can browse but never write.
# Any random secret works, e.g. `openssl rand -hex 24`. Unlock the editing UI by
# visiting the site with ?key=<this value> once, or entering it in the lock dialog.
OWNER_KEY=

# Optional speech-to-text provider for Twitch/Kick VODs.
# Choose one provider; YouTube captions do not need any key.
# Recommended low-cost option:
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Local whisper rig (faster-whisper-server, OpenAI-compatible) - free, uses your
# own GPU. Set TRANSCRIPTION_PROVIDER=local and point at the rig:
# LOCAL_WHISPER_BASE_URL=http://192.168.4.21:1234
# LOCAL_WHISPER_MODEL=whisper-large-v3-turbo
# Keep `openai` for faster-whisper-server. Use `whisper-cpp` for a Vulkan
# whisper.cpp server, which receives /inference and returns timestamped JSON.
# LOCAL_WHISPER_PROTOCOL=openai
# LOCAL_WHISPER_LANGUAGE=en
# Local faster-whisper-server is single-flight; StreamRecap automatically forces
# local concurrency to 1. This timeout covers a cold model or a slow CPU fallback.
# LOCAL_WHISPER_TIMEOUT_MS=1800000
# How many audio chunks upload to Groq at once (local always uses 1;
# paid tiers handle ~3 fine; free tier may 429 with more than 1-2).
TRANSCRIPTION_CONCURRENCY=3
# Max times a background job auto-resumes after a rate-limit cooldown before giving up.
TRANSCRIPTION_MAX_RETRIES=5
# Estimated monthly spend cap shown in the UI. Match your Groq console spend limit
# (default $10). Only an estimate — Groq enforces the real cap server-side.
GROQ_MONTHLY_CAP_DOLLARS=10
# Public URL Groq can fetch to reach this server's batch-audio chunks. Set this to
# your tunnel/domain root (no trailing slash), e.g. https://cool-name.trycloudflare.com
# Required only for overnight batch mode (half-price transcription via Groq batch API).
GROQ_BATCH_BASE_URL=
# Long-VOD audio download timeout. A 13-hour Kick VOD may take longer than 20 minutes.
TRANSCRIPTION_DOWNLOAD_TIMEOUT_MS=7200000
# Synchronous transcription limit. Longer VODs should use a background job.
MAX_SYNC_TRANSCRIPTION_SECONDS=1800
# Capture frames for all eligible events by default; timestamps are not limited by this.
MAX_EVENT_FRAMES=100
# Maximum total frame-capture budget per recap (10 minutes by default).
FRAME_CAPTURE_BUDGET_MS=600000

# Other supported providers:
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
